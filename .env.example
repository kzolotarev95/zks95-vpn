# Copy to .env. Never commit .env. Generate a URL-safe password: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-password
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
TRUSTED_HOSTS=["localhost","127.0.0.1","api"]
ENABLE_DOCS=true
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1

# Production: scripts/install.sh --production (requires existing TLS certificates)
DOMAIN=vpn.example.com
TLS_DIRECTORY=/etc/letsencrypt

# Future integrations; not active in this milestone. Do not enable real sales yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
